# Chrome Web Store用 OAuth Client ID（本番ビルド必須）
OAUTH_CLIENT_ID=your_store_oauth_client_id

# ローカル開発用 OAuth Client ID（npm run dev 時に使用、未設定時はOAUTH_CLIENT_IDにフォールバック）
LOCAL_OAUTH_CLIENT_ID=your_local_dev_oauth_client_id

# Web アプリ版用 OAuth Client ID（種別: ウェブ アプリケーション）。
# npm run build:web の本番ビルドで必須。承認済みオリジンに https://youkiti.github.io と
# http://localhost:8080 を登録すること。スコープは拡張機能と同一の3つのまま増やさない。
WEB_OAUTH_CLIENT_ID=your_web_app_oauth_client_id

# Local LLM Experiment API Key
GEMINI_API_KEY=your_api_key_here

# --- 以下は廃止済み（zip/Drive配布経路、最終利用 v0.24.0）。再開時は git 履歴を参照 ---
# DIST_COPY_PATH=C:\path\to\your\google-drive\folder
# ZIP_OAUTH_CLIENT_ID=your_zip_distribution_oauth_client_id
