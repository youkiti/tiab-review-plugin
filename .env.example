# 拡張版 launchWebAuthFlow 用 OAuth Client ID（種別: ウェブ アプリケーション）。
# 承認済みリダイレクトURIに https://alejlnlfflogpnabpbplmnojgoeeabij.chromiumapp.org/（ストア版）と
# https://ifnejjicfekmighagknaacliiiliodgf.chromiumapp.org/（dev版）の2つを登録すること（末尾スラッシュ必須）。
WEBAUTH_CLIENT_ID=your_webauth_client_id

# 旧 getAuthToken 方式用（ロールバック用に残置・現行ビルドでは未使用）
# Chrome Web Store用 OAuth Client ID
OAUTH_CLIENT_ID=your_store_oauth_client_id

# 旧 getAuthToken 方式用（ロールバック用に残置・現行ビルドでは未使用）
# ローカル開発用 OAuth Client ID（未設定時はOAUTH_CLIENT_IDにフォールバック）
LOCAL_OAUTH_CLIENT_ID=your_local_dev_oauth_client_id

# Web アプリ版用 OAuth Client ID（種別: ウェブ アプリケーション）。
# npm run build:web の本番ビルドで必須。承認済みオリジンに https://youkiti.github.io と
# http://localhost:8080 を登録すること。スコープは userinfo.email / drive.file の2つのまま増やさない。
WEB_OAUTH_CLIENT_ID=your_web_app_oauth_client_id

# Google Picker API 用。GitHub Pages 本番配信では repository variables にも同名で設定する。
# APIキーは HTTP リファラーを https://youkiti.github.io/*（ローカル検証時は http://localhost:8080/* も）に制限し、Picker API のみに制限する。
PICKER_API_KEY=your_picker_api_key
GCP_PROJECT_NUMBER=your_gcp_project_number

# Picker ページのURL上書き（任意・dev ビルド限定）。未設定なら本番URLを使う。
# Picker 導線をローカル配信で検証したいときだけ設定する（例: npx http-server docs/app -p 8080）。
# 本番ビルドでは無視されるため、localhost が成果物へ焼き込まれることはない。
# PICKER_PAGE_URL=http://localhost:8080/picker.html

# Local LLM Experiment API Key
GEMINI_API_KEY=your_api_key_here

# --- 以下は廃止済み（zip/Drive配布経路、最終利用 v0.24.0）。再開時は git 履歴を参照 ---
# DIST_COPY_PATH=C:\path\to\your\google-drive\folder
# ZIP_OAUTH_CLIENT_ID=your_zip_distribution_oauth_client_id
