{
  "permissions": {
    "allow": [
      "Grep",
      "Bash(git submodule:*)",
      "Bash(git checkout *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(python)",
      "Bash(python -c ' *)",
      "Bash(xargs ls:*)",
      "Bash(xargs grep:*)",
      "Bash(echo \"exit=$?\")"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -B -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/remove_merged_worktrees.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
