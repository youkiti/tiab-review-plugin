{
    "name": "tiab-review-plugin",
    "version": "0.34.0",
    "description": "TiAb Review Plugin - Chrome Extension for Systematic Review Screening",
    "private": true,
    "scripts": {
        "build": "webpack --mode production",
        "build:release": "webpack --mode production && powershell -Command \"$v=(Get-Content package.json -Raw | ConvertFrom-Json).version; Compress-Archive -Path ./dist/* -DestinationPath ./dist.zip -Force; Write-Host \\\"Created dist.zip (v$v, Chrome Web Store submission)\\\"\"",
        "bump": "powershell -ExecutionPolicy Bypass -File ./scripts/bump-version.ps1",
        "bump:minor": "powershell -ExecutionPolicy Bypass -File ./scripts/bump-version.ps1 -BumpType minor",
        "bump:major": "powershell -ExecutionPolicy Bypass -File ./scripts/bump-version.ps1 -BumpType major",
        "release": "npm run bump && npm run build:release",
        "release:minor": "npm run bump:minor && npm run build:release",
        "release:major": "npm run bump:major && npm run build:release",
        "watch": "webpack --mode development --watch",
        "dev": "webpack --mode development",
        "build:demo": "webpack --mode development --env demo",
        "build:web": "webpack --mode production --env target=web",
        "dev:web": "webpack --mode development --env target=web",
        "watch:web": "webpack --mode development --watch --env target=web",
        "lint": "eslint src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "test": "tsc --project tests/tsconfig.json && node --test .tmp/tests/tests/*.test.js",
        "video:setup": "bash video/scripts/setup.sh",
        "video:record": "node video/scripts/record.mjs",
        "video:tts": "node video/scripts/tts.mjs",
        "video:assemble": "node video/scripts/assemble.mjs"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.260",
        "@types/google.accounts": "^0.0.18",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "dotenv": "^17.2.3",
        "eslint": "^8.57.0",
        "playwright": "^1.62.0",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "webpack": "^5.90.0",
        "webpack-cli": "^5.1.4"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "author": "",
    "license": "MIT",
    "dependencies": {
        "jstat": "^1.9.6",
        "pdfjs-dist": "^4.10.38"
    }
}
