  "llm_tip_model": {
    "message": "Pick the Gemini model used for screening.\n• Gemini 3 Flash: recommended. Higher accuracy.\n• Gemini 2.5 Flash Lite: faster and cheaper, good for large batches.\nWhen in doubt, use Gemini 3 Flash."
  },
  "llm_tip_outputLanguage": {
    "message": "Sets the language of the AI's reasoning (reason) output.\nRecommended: match your everyday working language."
  },
  "llm_tip_apiKey": {
    "message": "Enter the Gemini API key from Google AI Studio.\nFree-tier keys work but are throttled (~13 s/item).\nLarge runs are best on a paid tier (Tier 1+)."
  },
  "llm_tip_apiKeySave": {
    "message": "When ON, the API key is stored encrypted on this device.\nTurn OFF on shared PCs (key is then kept only for the session)."
  },
  "llm_tip_protocol": {
    "message": "Paste your protocol's inclusion/exclusion criteria here as-is.\nClick 'Optimize criteria' and the AI will turn it into a screening prompt."
  },
  "llm_tip_tier": {
    "message": "Select your Gemini API tier. Parallel requests and save batch size are derived automatically from this tier.\n\n■ How to check your tier\n1. Open https://aistudio.google.com/usage\n2. See the current tier under \"Billing\"\n\n■ Tier overview\n• Tier 1: instant after enabling billing (300 RPM)\n• Tier 2: cumulative $100 + 3 days after first payment (2,000 RPM)\n• Tier 3: cumulative $1,000 + 30 days (4,000+ RPM)\n\nA wrong selection causes frequent rate-limit errors. If unsure, choose Tier 1."
  },
  "llm_tip_maxCount": {
    "message": "Maximum number of pending references to process in this run.\nFor example, if 10,000 references are pending and you choose 100, only the first 100 will be processed and the remaining 9,900 will be carried over to subsequent runs.\nChoose \"All\" to process every pending reference."
  },
  "llm_tip_threshold": {
    "message": "Choose how broadly AI should collect include candidates.\n0.3: broad\n0.5: standard. Use this if unsure\n0.7: strict\nYou can adjust while checking the distribution graph below."
  },
  "ml_tip_stopping": {
    "message": "Choose when screening should be considered finished.\nRecommended:\n• 50 consecutive Excludes (simple rule)\n• Target recall 95% / confidence 95% (statistical rule)\nPick based on the project size."
  }
