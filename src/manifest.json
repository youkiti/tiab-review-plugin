{
    "manifest_version": 3,
    "name": "TiAb Review Plugin",
    "version": "0.1.0",
    "description": "Systematic Review のタイトル・抄録スクリーニングを効率化するChrome拡張機能",
    "permissions": [
        "identity",
        "storage",
        "sidePanel"
    ],
    "host_permissions": [
        "https://sheets.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "451307229828-kf21vg8iof38ck0f0pu5m1ms7hqslib0.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/spreadsheets",
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/drive.file"
        ]
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "TiAb Review"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+T",
                "mac": "Command+Shift+T"
            },
            "description": "Open TiAb Review"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}